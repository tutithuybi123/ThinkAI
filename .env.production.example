NODE_ENV=production
THINKAI_DATABASE_URL=postgresql://thinkai:${POSTGRES_PASSWORD}@postgres:5432/thinkai
THINKAI_SESSION_SECRET=replace-with-32-plus-random-characters
THINKAI_CONTENT_PATH=/run/secrets/approved-content.json
THINKAI_DEMO_SEED_PATH=/run/secrets/demo-seed.json
THINKAI_DEMO_SEED_SHA256=replace-with-approved-seed-sha256
THINKAI_DEMO_SEED_VERSION=replace-with-approved-seed-version
THINKAI_DEMO_STAFF_BOOTSTRAP_SECRET=replace-with-staff-bootstrap-secret
THINKAI_AI_PROVIDER=tokenrouter
THINKAI_AI_MODEL=replace-with-fixed-qualified-tokenrouter-model
TOKENROUTER_API_KEY=
TOKENROUTER_BASE_URL=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
POSTGRES_PASSWORD=
CLOUDFLARE_TUNNEL_TOKEN=
