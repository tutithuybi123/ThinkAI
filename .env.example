# ThinkAI Competition MVP — runtime configuration template
# Copy to .env.local. Never commit real credentials or teacher-reviewed content.

NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Required by src/runtime/server.ts. Use a dedicated local/demo database.
THINKAI_DATABASE_URL=postgresql://thinkai:replace-me@localhost:5432/thinkai
# At least 32 random characters; generate and keep this value private.
THINKAI_SESSION_SECRET=replace-with-a-private-random-secret-of-at-least-32-characters

# Required approved, teacher-reviewed JSON bundles. The application fails closed
# when either path is missing or invalid; structural fixtures are not runtime content.
THINKAI_CONTENT_PATH=./private/approved-content.json
THINKAI_DEMO_SEED_PATH=./private/demo-seed.json
# Exact SHA-256 and shared reviewed-fixture version for that seed. These bind
# startup to the approved source and prevent silent baseline replacement.
THINKAI_DEMO_SEED_SHA256=replace-with-64-lowercase-hex-sha256-of-demo-seed-json
THINKAI_DEMO_SEED_VERSION=replace-with-reviewed-fixture-version

# Optional and deployment-only. Enables the protected presenter/auditor bootstrap
# route for a live competition demo. Leave unset to disable that route completely.
THINKAI_DEMO_STAFF_BOOTSTRAP_SECRET=
