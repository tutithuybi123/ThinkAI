# THINKAI KIDS MVP - Environment Variables Template
# Copy this file to .env.local for local development. Never commit real credentials!

PORT=3000
NODE_ENV=development

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database Configuration (Placeholder)
DATABASE_URL="postgresql://user:password@localhost:5432/thinkai_dev"

# AI Service Credentials (Placeholders)
OPENAI_API_KEY=your-openai-api-key-here
LLM_MODEL=gpt-4o-mini

# Feature Flags
ENABLE_AI_EVALS=false
ENABLE_PLAYWRIGHT_LOGS=true
